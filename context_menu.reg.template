Windows Registry Editor Version 5.00

; ============================================================
; ConvTool v1 — menu klik kanan Windows Explorer.
; File ini TEMPLATE: install.bat mengganti __INSTALLDIR__ dengan
; folder install sebenarnya (mis. C:\\Tools\\ConvTool) lalu
; menjalankan: reg import ConvTool_context_menu.reg
; JANGAN edit file ini langsung untuk install — jalankan install.bat.
; ============================================================

; ---------- Perintah (CommandStore, supaya bisa dipakai ulang) ----------

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\CommandStore\shell\ConvTool.Resize]
@="Resize Pictures"
"MUIVerb"="Resize Pictures"
"Icon"="__INSTALLDIR__\\ConvTool.exe"

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\CommandStore\shell\ConvTool.Resize\command]
@="\"__INSTALLDIR__\\ConvTool.exe\" resize-image \"%1\""

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\CommandStore\shell\ConvTool.ImagesToPdf]
@="Images to PDF"
"MUIVerb"="Images to PDF"
"Icon"="__INSTALLDIR__\\ConvTool.exe"

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\CommandStore\shell\ConvTool.ImagesToPdf\command]
@="\"__INSTALLDIR__\\ConvTool.exe\" images-to-pdf \"%1\""

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\CommandStore\shell\ConvTool.Exif]
