[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\CommandStore\shell\ConvTool.WatermarkJob]
@="Watermark Job"
"MUIVerb"="Watermark Job"
"Icon"="__INSTALLDIR__\\ConvTool.exe"

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\CommandStore\shell\ConvTool.WatermarkJob\command]
@="\"__INSTALLDIR__\\ConvTool.exe\" watermark-job \"%1\""

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\CommandStore\shell\ConvTool.ResizePdf]
@="Resize PDF"
"MUIVerb"="Resize PDF"
"Icon"="__INSTALLDIR__\\ConvTool.exe"

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\CommandStore\shell\ConvTool.ResizePdf\command]
