"MUIVerb"="Edit EXIF"
"Icon"="__INSTALLDIR__\\ConvTool.exe"

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\CommandStore\shell\ConvTool.Exif\command]
@="\"__INSTALLDIR__\\ConvTool.exe\" exif \"%1\""

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\CommandStore\shell\ConvTool.WatermarkKlasik]
@="Watermark Klasik"
"MUIVerb"="Watermark Klasik"
"Icon"="__INSTALLDIR__\\ConvTool.exe"

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\CommandStore\shell\ConvTool.WatermarkKlasik\command]
