"Icon"="__INSTALLDIR__\\ConvTool.exe"

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\CommandStore\shell\ConvTool.PdfToImages\command]
@="\"__INSTALLDIR__\\ConvTool.exe\" pdf-to-images \"%1\""

; ---------- Submenu "ConvTool" untuk file gambar ----------

[HKEY_CLASSES_ROOT\SystemFileAssociations\.jpg\shell\ConvTool]
"MUIVerb"="ConvTool"
"SubCommands"="ConvTool.Resize;ConvTool.ImagesToPdf;ConvTool.Exif;ConvTool.WatermarkKlasik;ConvTool.WatermarkJob"
"Icon"="__INSTALLDIR__\\ConvTool.exe"

